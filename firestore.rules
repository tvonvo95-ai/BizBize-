rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Test connection doc
    match /test/{docId} {
      allow read: if true;
    }

    // User profiles
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId
        && request.resource.data.uid == userId;
      allow update: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    // Chats
    match /chats/{chatId} {
      allow get: if isSignedIn() && isValidId(chatId) && (request.auth.uid in resource.data.participants);
      allow list: if isSignedIn() && (request.auth.uid in resource.data.participants);
      allow create: if isSignedIn() && isValidId(chatId) && (request.auth.uid in request.resource.data.participants);
      allow update: if isSignedIn() && isValidId(chatId) && (request.auth.uid in resource.data.participants);
      allow delete: if isSignedIn() && isValidId(chatId) && (request.auth.uid in resource.data.participants);

      // Messages subcollection
      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(messageId)
          && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants);
        allow list: if isSignedIn()
          && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants);
        allow create: if isSignedIn() && isValidId(messageId)
          && request.resource.data.senderId == request.auth.uid
          && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants);
        allow update: if isSignedIn() && isValidId(messageId)
          && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants);
        allow delete: if isSignedIn() && isValidId(messageId)
          && resource.data.senderId == request.auth.uid;
      }
    }

    // Stories (Status updates)
    match /stories/{storyId} {
      allow get: if isSignedIn() && isValidId(storyId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(storyId) && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(storyId);
      allow delete: if isSignedIn() && isValidId(storyId) && resource.data.userId == request.auth.uid;
    }

    // WebRTC Calls
    match /calls/{callId} {
      allow get: if isSignedIn() && isValidId(callId)
        && (resource.data.callerId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow list: if isSignedIn()
        && (resource.data.callerId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(callId)
        && request.resource.data.callerId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(callId)
        && (resource.data.callerId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow delete: if isSignedIn() && isValidId(callId)
        && (resource.data.callerId == request.auth.uid || resource.data.receiverId == request.auth.uid);

      match /callerCandidates/{candId} {
        allow get: if isSignedIn() && isValidId(candId)
          && (get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid
           || get(/databases/$(database)/documents/calls/$(callId)).data.receiverId == request.auth.uid);
        allow list: if isSignedIn()
          && (get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid
           || get(/databases/$(database)/documents/calls/$(callId)).data.receiverId == request.auth.uid);
        allow write: if isSignedIn() && isValidId(candId)
          && (get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid
           || get(/databases/$(database)/documents/calls/$(callId)).data.receiverId == request.auth.uid);
      }

      match /receiverCandidates/{candId} {
        allow get: if isSignedIn() && isValidId(candId)
          && (get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid
           || get(/databases/$(database)/documents/calls/$(callId)).data.receiverId == request.auth.uid);
        allow list: if isSignedIn()
          && (get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid
           || get(/databases/$(database)/documents/calls/$(callId)).data.receiverId == request.auth.uid);
        allow write: if isSignedIn() && isValidId(candId)
          && (get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid
           || get(/databases/$(database)/documents/calls/$(callId)).data.receiverId == request.auth.uid);
      }
    }

    // Friendships
    match /friendships/{friendshipId} {
      allow get: if isSignedIn() && isValidId(friendshipId)
        && (resource.data.requesterId == request.auth.uid || resource.data.recipientId == request.auth.uid);
      allow list: if isSignedIn()
        && (resource.data.requesterId == request.auth.uid || resource.data.recipientId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(friendshipId)
        && request.resource.data.requesterId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(friendshipId)
        && (resource.data.requesterId == request.auth.uid || resource.data.recipientId == request.auth.uid);
      allow delete: if isSignedIn() && isValidId(friendshipId)
        && (resource.data.requesterId == request.auth.uid || resource.data.recipientId == request.auth.uid);
    }
  }
}
